---
interface Props {
  unit: string;
  value: string;
  label: string;
}

const { unit, value, label } = Astro.props;
---

<div class="flex flex-col items-center gap-4 md:gap-6">
  <div
    class="flip-card relative flex items-center justify-center overflow-hidden bg-card-bg rounded-md md:rounded-lg shadow-[0_8px_0_var(--color-slate-900)] w-16 h-16 min-[375px]:w-20 min-[375px]:h-20 md:w-36 md:h-36"
    data-unit={unit}
    aria-label={`${label}: ${value}`}
  >
    <span
      class="countdown-value text-text-pink text-4xl md:text-7xl font-bold z-20"
      aria-hidden="true"
      >{value}</span
    >
    <div
      class="absolute top-0 left-0 w-full h-1/2 bg-black/10 rounded-t-md md:rounded-t-lg"
    >
    </div>
  </div>
  <span
    class="text-text-gray text-[0.5rem] min-[375px]:text-[0.625rem] md:text-sm tracking-[0.3em] uppercase"
    aria-hidden="true"
    >{label}</span
  >
</div>

<style>
  .flip-card::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background-color: rgba(0, 0, 0, 0.25);
    z-index: 10;
  }
</style>
