---
import BaseLayout from "../layouts/BaseLayout.astro";
import Countdown from "../components/Countdown.astro";
---

<BaseLayout title="Frontend Mentor | Launch countdown timer">
  <main
    class="flex-1 flex flex-col justify-center items-center w-full px-4 pt-24 pb-16 md:pt-32 md:pb-24 z-10"
  >
    <h1
      class="text-white tracking-[0.3em] md:tracking-[0.5em] uppercase text-sm md:text-2xl mb-16 md:mb-24 text-center font-bold"
    >
      We're launching soon
    </h1>

    <Countdown />
  </main>
</BaseLayout>
