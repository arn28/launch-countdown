---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Frontend Mentor | Launch countdown timer">
	<!-- Contenido Principal -->
	<main
		class="flex-1 flex flex-col justify-center items-center w-full px-4 z-10 pt-32 overflow-hidden"
	>
		<h1
			class="text-white tracking-[0.3em] uppercase text-sm md:text-2xl mb-16 md:mb-24 text-center font-bold"
		>
			We're launching soon
		</h1>

		<!-- Contenedor del Contador -->
		<div class="flex gap-4 md:gap-8 justify-center">
			<!-- Días -->
			<div class="flex flex-col items-center gap-4 md:gap-6">
				<div
					class="relative bg-card-bg rounded-md md:rounded-lg shadow-[0_8px_0_var(--color-slate-900)] w-16 h-16 md:w-36 md:h-36 flex items-center justify-center flip-card overflow-hidden"
				>
					<span
						class="text-text-pink text-4xl md:text-8xl font-bold z-20"
						>08</span
					>
					<!-- Sombra superior para el efecto 3D de la tarjeta -->
					<div
						class="absolute top-0 left-0 w-full h-1/2 bg-black/10 rounded-t-md md:rounded-t-lg"
					>
					</div>
				</div>
				<span
					class="text-text-gray text-[0.5rem] md:text-sm tracking-[0.3em] uppercase"
					>Days</span
				>
			</div>

			<!-- Horas -->
			<div class="flex flex-col items-center gap-4 md:gap-6">
				<div
					class="relative bg-card-bg rounded-md md:rounded-lg shadow-[0_8px_0_var(--color-slate-900)] w-16 h-16 md:w-36 md:h-36 flex items-center justify-center flip-card overflow-hidden"
				>
					<span
						class="text-text-pink text-4xl md:text-8xl font-bold z-20"
						>23</span
					>
					<div
						class="absolute top-0 left-0 w-full h-1/2 bg-black/10 rounded-t-md md:rounded-t-lg"
					>
					</div>
				</div>
				<span
					class="text-text-gray text-[0.5rem] md:text-sm tracking-[0.3em] uppercase"
					>Hours</span
				>
			</div>

			<!-- Minutos -->
			<div class="flex flex-col items-center gap-4 md:gap-6">
				<div
					class="relative bg-card-bg rounded-md md:rounded-lg shadow-[0_8px_0_var(--color-slate-900)] w-16 h-16 md:w-36 md:h-36 flex items-center justify-center flip-card overflow-hidden"
				>
					<span
						class="text-text-pink text-4xl md:text-8xl font-bold z-20"
						>55</span
					>
					<div
						class="absolute top-0 left-0 w-full h-1/2 bg-black/10 rounded-t-md md:rounded-t-lg"
					>
					</div>
				</div>
				<span
					class="text-text-gray text-[0.5rem] md:text-sm tracking-[0.3em] uppercase"
					>Minutes</span
				>
			</div>

			<!-- Segundos -->
			<div class="flex flex-col items-center gap-4 md:gap-6">
				<div
					class="relative bg-card-bg rounded-md md:rounded-lg shadow-[0_8px_0_var(--color-slate-900)] w-16 h-16 md:w-36 md:h-36 flex items-center justify-center flip-card overflow-hidden"
				>
					<span
						class="text-text-pink text-4xl md:text-8xl font-bold z-20"
						>41</span
					>
					<div
						class="absolute top-0 left-0 w-full h-1/2 bg-black/10 rounded-t-md md:rounded-t-lg"
					>
					</div>
				</div>
				<span
					class="text-text-gray text-[0.5rem] md:text-sm tracking-[0.3em] uppercase"
					>Seconds</span
				>
			</div>
		</div>
	</main>
</BaseLayout>

<style>
	/* Efecto visual de la tarjeta dividida por la mitad (Flip clock) */
	.flip-card::before {
		content: "";
		position: absolute;
		top: 50%;
		left: 0;
		right: 0;
		height: 1px;
		background-color: rgba(0, 0, 0, 0.25);
		z-index: 10;
	}
</style>
